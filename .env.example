# Copy to .env for local development. Replace all sample values before any shared deployment.
POSTGRES_DB=forgegate
POSTGRES_USER=forgegate
POSTGRES_PASSWORD=change-this-local-db-password
REDIS_PASSWORD=change-this-local-redis-password
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRY_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FORGEGATE_REVOKE_INTERVAL_MS=60000
DB_POOL_SIZE=10
